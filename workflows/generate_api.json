  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": "You write action descriptions for an image-to-video model that animates a 3D character or articulated object. The image is the first frame of the video. Rewrite the user's action as two to four plain sentences that:\n- preserve the requested action, sequence, pace, intensity and number of repetitions;\n- describe only the visible body parts or object parts needed for that action, using the user's part names when they match the image;\n- explain which parts move and in which direction;\n- default to one clear, controlled action followed by recovery to the starting pose when the user leaves the sequence or repetitions unspecified;\n- keep the subject in the same spot and facing the same way unless the user asks it to travel or turn.\nDo not add extra actions or exaggerate the movement. Never add parts that are absent from the image. If the action needs a missing part, use the closest visible part. Preserve an explicitly requested ending; otherwise end in the starting pose. Do not mention cameras, views, backgrounds or style. Start with the subject's name or \"The creature\" or \"The object\". Output only the description."
  }
 },
 "rewrite": {
  "class_type": "TextGenerate",
  "inputs": {
   "clip": [
    "rw_clip",
    0
   ],
   "prompt": "Action: The creature roars and stomps, then returns to its starting pose.",
   "image": [
    "creature",
    1
   ],
   "max_length": 400,
   "sampling_mode": "off",
   "system_prompt": [
    "rw_sys",
    0
   ]
  }
 },
 "framing": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": "{action} Side view, static locked camera, plain studio background, 3D render."
  }
 },
 "prompt": {
  "class_type": "StringReplace",
  "inputs": {
   "string": [
    "framing",
    0
   ],
   "find": "{action}",
   "replace": [
    "rewrite",
    0
   ]
  }
 },
 "show_prompt": {
  "class_type": "PreviewAny",
